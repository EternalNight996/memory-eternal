{
  "$schema": "urn:dsh-std:community-draft:dsh-plugin:0.15",
  "id": "memory-eternal-tui",
  "name": "memory-eternal-tui",
  "version": "0.12.0",
  "manifestVersion": "0.15",
  "description": "Open the local Memory Atlas Web UI from dsh-TUI.",
  "facets": {
    "host": {
      "entry": "main.js",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "commands.dsh/v1alpha1",
        "kind": "Command"
      }
    ]
  },
  "permissions": [],
  "contributes": {
    "commands": [
      {
        "id": "memory-eternal-tui.open",
        "title": "memory",
        "description": "Open Memory Atlas in the browser"
      }
    ]
  },
  "subscriptions": [],
  "license": "MIT",
  "source": {
    "repository": "https://github.com/EternalNight996/memory-eternal"
  }
}
