{
  "SessionEnd": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/capture.mjs\" claude-code"
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Read|Bash|Grep|Glob",
